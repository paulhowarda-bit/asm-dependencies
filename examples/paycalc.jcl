//PAYRUN   JOB (ACCT),'PAYROLL',CLASS=A,MSGCLASS=X
//*
//* Runs the assembler module PAYCALC. Unlike an Easytrieve step, whose
//* EXEC PGM= is the interpreter, an assembler step's EXEC PGM= IS the
//* module - so this is what closes its ddnames to real datasets.
//*
//PAYSTEP  EXEC PGM=PAYCALC
//STEPLIB  DD  DISP=SHR,DSN=PROD.LOADLIB
//CUSTMAST DD  DISP=SHR,DSN=PROD.CUSTOMER.MASTER
//PAYHIST  DD  DISP=OLD,DSN=PROD.PAYROLL.HISTORY
//PAYRPT   DD  DSN=PROD.PAYROLL.REPORT,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,1),RLSE),DCB=(RECFM=FB,LRECL=133)
//SYSPRINT DD  SYSOUT=*
//*
//NEXTSTEP EXEC PGM=PAYNEXT,COND=(0,NE,PAYSTEP)
//PAYRPT   DD  DISP=SHR,DSN=PROD.PAYROLL.REPORT
//SYSPRINT DD  SYSOUT=*
